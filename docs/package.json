    "fumadocs-typescript": "5.6.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "isbot": "5.2.3",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
